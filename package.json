{
  "name": "toron.dev",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter toron-dev build",
    "dev": "bun run --filter toron-dev dev",
    "lint": "bun run --filter toron-dev lint",
    "format": "bun run --filter toron-dev format"
  }
}
