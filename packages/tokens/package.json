{
  "name": "@toron/tokens",
  "version": "0.1.0",
  "description": "toron.dev design tokens + base components (ADR-0001 D2)",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./theme.css"
  ],
  "exports": {
    "./theme.css": "./theme.css",
    "./tokens": {
      "types": "./tokens.ts",
      "default": "./tokens.ts"
    },
    "./use-theme": {
      "types": "./components/use-theme.ts",
      "default": "./components/use-theme.ts"
    },
    "./theme-toggle": {
      "types": "./components/theme-toggle.tsx",
      "default": "./components/theme-toggle.tsx"
    },
    "./terminal-pane": {
      "types": "./components/terminal-pane.tsx",
      "default": "./components/terminal-pane.tsx"
    },
    "./ascii-strip": {
      "types": "./components/ascii-strip.tsx",
      "default": "./components/ascii-strip.tsx"
    },
    "./sealed-envelope-badge": {
      "types": "./components/sealed-envelope-badge.tsx",
      "default": "./components/sealed-envelope-badge.tsx"
    },
    "./violet-glow": {
      "types": "./components/violet-glow.tsx",
      "default": "./components/violet-glow.tsx"
    },
    "./state-glyph": {
      "types": "./components/state-glyph.tsx",
      "default": "./components/state-glyph.tsx"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
